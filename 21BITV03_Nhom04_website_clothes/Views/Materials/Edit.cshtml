@model _21BITV03_Nhom04_website_clothes.Data.Material

@{
    ViewData["Title"] = "Chỉnh sửa chất liệu";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chỉnh sửa Chất liệu</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Materials" asp-action="Index"><i class="fas fa-cubes me-1"></i> Danh sách chất liệu</a>
        </li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-edit me-2"></i> Cập nhật thông tin chất liệu
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaterialId" />

                <div class="mb-3">
                    <label asp-for="MaterialName" class="form-label fw-semibold">Tên chất liệu</label>
                    <input asp-for="MaterialName" class="form-control" placeholder="Nhập tên chất liệu..." />
                    <span asp-validation-for="MaterialName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả (nếu có)..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
