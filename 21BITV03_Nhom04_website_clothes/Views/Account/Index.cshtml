
@model _21BITV03_Nhom04_website_clothes.Models.AccountViewModel

@{
    ViewData["Title"] = "Tổng quan tài khoản";
    Layout = "~/Views/Shared/_Layout_LoginAndRegister.cshtml";
}

<div class="container-fluid page-header-login py-5">
    <h1 class="text-center text-white display-6">Trang cá nhân</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Account")">Trang cá nhân</a></li>
    </ol>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row">
            <!-- Sidebar Menu -->
            <div class="col-lg-3 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Quản lý tài khoản</h4>
                        <ul class="list-group">
                            <li class="list-group-item"><a href="#" class="account-nav-link nav-link" data-target="user-info">Thông tin cá nhân</a></li>
                            <li class="list-group-item"><a href="#" class="account-nav-link nav-link" data-target="order-info">Đơn hàng</a></li>
                            <li class="list-group-item">
                                <form asp-controller="Account" asp-action="LogOut" method="post">
                                    <button type="submit" class="btn btn-danger w-100">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div id="content">
                    <!-- Sections for user info and orders -->
                    <div id="user-info" class="section-content" style="display:none;">
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">Thông tin cá nhân</h4>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <p class="mb-0"><strong>Username:</strong></p>
                                    </div>
                                    <div class="col-md-8">
                                        <p class="mb-0">@Model.Users.UserName</p>
                                    </div>
                                </div>
                                <hr />
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <p class="mb-0"><strong>Full Name:</strong></p>
                                    </div>
                                    <div class="col-md-8">
                                        <p class="mb-0">@Model.UserInfoes.FullName</p>
                                    </div>
                                </div>
                                <hr />
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <p class="mb-0"><strong>Email:</strong></p>
                                    </div>
                                    <div class="col-md-8">
                                        <p class="mb-0">@Model.Users.Email</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div id="order-info" class="section-content" style="display:none;">
                        <h2>Thông tin đơn hàng</h2>
                        @if (Model.Orders != null)
                        {
                            <ul class="list-group">
                                @foreach (var order in Model.UserInfoes.Orders)
                                {
                                    <li class="list-group-item">
                                        <div class="row align-items-center py-2 border-bottom">
                                            <div class="col-md-3">
                                                <p class="mb-1"><strong>Mã đơn:</strong> @order.OrderId</p>
                                                <p class="mb-0"><strong>Trạng thái:</strong> @order.OrderStatus</p>
                                            </div>
                                            <div class="col-md-3">
                                                <p class="mb-0"><strong>Tổng đơn hàng:</strong> @(order.OrderTotal?.ToString("N0") ?? "0") ₫</p>
                                            </div>


                                            <div class="col-md-3 text-md-end mt-2 mt-md-0">
                                                <a href="@Url.Action("ExportOrdersToExcel", "Account", new { orderId = order.OrderId })" class="btn btn-success w-100 w-md-auto">
                                                    <i class="bi bi-file-earmark-excel"></i> Tải Excel
                                                </a>
                                            </div>

                                            <div class="col-md-3 text-md-end mt-2 mt-md-0">
                                                <button class="btn btn-primary w-100 w-md-auto" onclick="toggleOrderDetails('order-@order.OrderId')">
                                                    <i class="bi bi-info-circle"></i> Thông tin chi tiết
                                                </button>
                                            </div>
                                        </div>




                                        <!-- Hidden Order Product Details -->
                                        <div id="order-@order.OrderId" class="order-product-details" style="display:none;">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Tên sản phẩm</th>
                                                        <th>Số lượng</th>
                                                        <th>Màu</th>
                                                        <th>Kích cỡ</th>
                                                        <th>Chất liệu</th>
                                                        <th>Giá</th>
                                                    </tr>
                                                </thead>
                                                <tbody> 

                                                    @foreach (var orderProduct in order.OrderProductLists)
                                                    {
                                                        <tr>
                                                            <td>@orderProduct.ProductName</td>
                                                            <td>@orderProduct.Quanity</td>
                                                            <td>@orderProduct.ColorName</td>
                                                            <td>@orderProduct.SizeName</td>
                                                            <td>@orderProduct.MaterialName</td>
                                                            <td>@orderProduct.Price</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No orders found for this user.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Include jQuery for simplicity -->
<script>
    $(document).ready(function () {
        $('.account-nav-link').click(function (e) {
            e.preventDefault();
            var targetId = $(this).data('target');

            // Hide all section contents
            $('.section-content').hide();

            // Show the selected section content
            $('#' + targetId).show();
        });

        // Mặc định hiển thị Thông tin cá nhân
        $('#user-info').show();
    });

    function toggleOrderDetails(orderId) {
        var element = document.getElementById(orderId);
        element.style.display = (element.style.display === "none") ? "block" : "none";
    }
</script>
