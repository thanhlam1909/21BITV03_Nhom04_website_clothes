@model _21BITV03_Nhom04_website_clothes.Data.Supplier

@{
    ViewData["Title"] = "Xóa Nhà Cung Cấp";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Xóa Nhà Cung Cấp</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Suppliers" asp-action="Index"><i class="fas fa-truck me-1"></i> Danh sách nhà cung cấp</a>
        </li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-exclamation-triangle me-2"></i> Xác nhận xóa nhà cung cấp
        </div>
        <div class="card-body p-4">
            <p class="fw-semibold text-danger">Bạn có chắc chắn muốn xóa nhà cung cấp sau không?</p>

            <dl class="row">
                <dt class="col-sm-3 fw-semibold">Tên nhà cung cấp</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.SupplierName)</dd>

                <dt class="col-sm-3 fw-semibold">Thông tin liên hệ</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactInfo)</dd>

                <dt class="col-sm-3 fw-semibold">Địa chỉ</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

                <dt class="col-sm-3 fw-semibold">Email</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-3 fw-semibold">Số điện thoại</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="SupplierId" />

                <div class="d-flex justify-content-start gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash-alt me-1"></i> Xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
