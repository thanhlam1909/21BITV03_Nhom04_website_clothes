@model _21BITV03_Nhom04_website_clothes.Data.Supplier

@{
    ViewData["Title"] = "Thêm Nhà Cung Cấp";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Thêm Nhà Cung Cấp</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Suppliers" asp-action="Index"><i class="fas fa-truck me-1"></i> Danh sách nhà cung cấp</a>
        </li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header bg-success text-white">
            <i class="fas fa-plus me-2"></i> Nhập thông tin nhà cung cấp mới
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="SupplierName" class="form-label fw-semibold">Tên nhà cung cấp</label>
                    <input asp-for="SupplierName" class="form-control" placeholder="Nhập tên nhà cung cấp..." />
                    <span asp-validation-for="SupplierName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactInfo" class="form-label fw-semibold">Thông tin liên hệ</label>
                    <input asp-for="ContactInfo" class="form-control" placeholder="Nhập người liên hệ hoặc thông tin liên hệ..." />
                    <span asp-validation-for="ContactInfo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ nhà cung cấp..." />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email..." />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-start gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save me-1"></i> Lưu nhà cung cấp
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
