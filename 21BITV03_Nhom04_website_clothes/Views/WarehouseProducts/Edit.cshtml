@model _21BITV03_Nhom04_website_clothes.Data.WarehouseProduct

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm trong kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-route-warehouseId="@Model.WarehouseId" asp-action="Index"><i class="fas fa-cogs me-1"></i> Danh sách sản phẩm trong kho</a>
        </li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-2"></i> Cập nhật thông tin sản phẩm trong kho
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="WarehouseProductId" />

                <div class="form-group mb-3">
                    <label asp-for="WarehouseId" class="form-label fw-bold">Kho hàng</label>
                    <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.WarehouseId"></select>
                    <span asp-validation-for="WarehouseId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Quantity" class="form-label fw-bold">Số lượng</label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="LastUpdated" class="form-label fw-bold">Ngày cập nhật</label>
                    <input asp-for="LastUpdated" class="form-control" type="datetime-local" />
                    <span asp-validation-for="LastUpdated" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SkuId" class="form-label fw-bold">Mã SKU</label>
                    <select asp-for="SkuId" class="form-select" asp-items="ViewBag.SkuId"></select>
                    <span asp-validation-for="SkuId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
