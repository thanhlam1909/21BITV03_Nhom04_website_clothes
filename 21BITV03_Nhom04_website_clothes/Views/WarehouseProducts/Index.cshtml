@model IEnumerable<_21BITV03_Nhom04_website_clothes.Data.WarehouseProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm trong kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh sách sản phẩm trong kho</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item"><a asp-controller="Warehouses" asp-action="Index">Kho hàng</a></li>
        <li class="breadcrumb-item active">Sản phẩm trong kho</li>
    </ol>

    <div class="card mb-4 shadow-sm rounded-3">
        <div class="card-header">
            <i class="fas fa-boxes me-2"></i> Danh sách sản phẩm trong kho
        </div>
        <div class="card-body">
            <table id="datatablesSimple" class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm (SKU)</th>
                        <th>Tên kho</th>
                        <th>Số lượng</th>
                        <th>Ngày cập nhật</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Sku?.SkuCode</td>
                            <td>@item.Warehouse?.WarehouseName</td>
                            <td>@item.Quantity</td>
                            <td>@item.LastUpdated?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.WarehouseProductId" class="btn btn-sm btn-warning me-1" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.WarehouseProductId" class="btn btn-sm btn-danger" title="Xoá">
                                    <i class="fas fa-trash"></i> Xoá
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
