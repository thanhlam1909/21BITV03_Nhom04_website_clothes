@model _21BITV03_Nhom04_website_clothes.Data.Order

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết đơn hàng</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Danh sách đơn hàng</a></li>
        <li class="breadcrumb-item active">Order Details</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-receipt me-1"></i>
            Thông tin đơn hàng
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã đơn hàng:</dt>
                <dd class="col-sm-9">@Model.OrderId</dd>

                <dt class="col-sm-3">Lời nhắn:</dt>
                <dd class="col-sm-9">@Model.Message</dd>

                <dt class="col-sm-3">Phương thức thanh toán:</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3">Trạng thái đơn hàng:</dt>
                <dd class="col-sm-9">@Model.OrderStatus</dd>

                <dt class="col-sm-3">Ngày đặt hàng:</dt>
                <dd class="col-sm-9">@Model.OrderDate</dd>

                <dt class="col-sm-3">Khách hàng:</dt>
                <dd class="col-sm-9">@Model.User?.FullName</dd>

                <dt class="col-sm-3">Email khách hàng:</dt>
                <dd class="col-sm-9">@Model.User?.Email</dd>

                <dt class="col-sm-3">Số điện thoại:</dt>
                <dd class="col-sm-9">@Model.User?.Phone</dd>

                <dt class="col-sm-3">Địa chỉ giao hàng:</dt>
                <dd class="col-sm-9">@Model.User?.Address</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-box-open me-1"></i>
            Danh sách sản phẩm
        </div>
        <div class="card-body">
            @if (Model.OrderProductLists != null && Model.OrderProductLists.Any())
            {
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Sản phẩm</th>
                            <th>Màu sản phẩm</th>
                            <th>Kích thước sản phẩm</th>
                            <th>Chất liệu sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal total = 0;
                        }
                        @foreach (var item in Model.OrderProductLists)
                        {
                            var price = (decimal)(item.Price ?? 0.0);
                            var lineTotal = (item.Quanity ?? 0) * price;
                            total += lineTotal;
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.ColorName</td>
                                <td>@item.SizeName</td>
                                <td>@item.MaterialName</td>
                                <td>@item.Quanity</td>
                                <td>@price.ToString("N0") ₫</td>
                                <td>@lineTotal.ToString("N0") ₫</td>
                            </tr>
                        }
                        <tr class="table-info">
                            <td colspan="6" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold">@total.ToString("N0") ₫</td>
                        </tr>
                    </tbody>
                </table>

            }
            else
            {
                <p>Không có sản phẩm nào trong đơn hàng này.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách đơn hàng
        </a>
    </div>
</div>
