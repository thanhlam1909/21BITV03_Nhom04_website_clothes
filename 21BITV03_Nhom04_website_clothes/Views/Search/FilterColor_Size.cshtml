@model _21BITV03_Nhom04_website_clothes.Models.FilterViewModel

@{
    ViewData["Title"] = "Lọc sản phẩm theo màu sắc, kích cỡ và giá";
    Layout = "~/Views/Shared/_Layout_LoginAndRegister.cshtml";
}

<div class="container-fluid page-header-login py-5">
    <h1 class="text-center text-white display-6">Trang tìm kiếm sản phẩm</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
        <li class="breadcrumb-item active">Tìm kiếm</li>
    </ol>
</div>

<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <div class="row g-4">
            <!-- Cột Lọc -->
            <div class="col-lg-3">
                <form asp-action="FilterColor_Size" method="get">
                    <div class="row g-4">
                        <!-- Màu sắc -->
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <h4>Chọn màu sắc:</h4>
                                <div class="row">
                                    @foreach (var color in Model.AvailableColors)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="color-@color.ColorId" name="colorIds" value="@color.ColorId"
                                                @(Model.SelectedColorIds.Contains(color.ColorId) ? "checked" : "") />
                                                <label class="form-check-label" for="color-@color.ColorId">@color.ColorName</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>


                        <!-- Kích cỡ -->
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <h4>Chọn kích cỡ:</h4>
                                <div class="row">
                                    @foreach (var size in Model.AvailableSizes)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="size-@size.ProductSizeId" name="sizeIds" value="@size.ProductSizeId"
                                                @(Model.SelectedSizeIds.Contains(size.ProductSizeId) ? "checked" : "") />
                                                <label class="form-check-label" for="size-@size.ProductSizeId">@size.SizeName</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- Loại sản phẩm -->

                        <div class="col-lg-12">
                            <div class="mb-3">
                                <h4>Chọn loại sản phẩm:</h4>
                                <div class="row">
                                    @foreach (var type in Model.AvailableProductTypes)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="type-@type.ProductTypeId" name="productTypeIds" value="@type.ProductTypeId"
                                                @(Model.SelectedProductTypeIds.Contains(type.ProductTypeId) ? "checked" : "") />
                                                <label class="form-check-label" for="type-@type.ProductTypeId">@type.ProductTypeName</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>


                        <!-- Giá -->
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <h4>Khoảng giá:</h4>

                                <label for="minPriceRange" class="form-label">Giá tối thiểu</label>
                                <input type="range" class="form-range" id="minPriceRange" min="0" max="5000000" value="0" step="10000">

                                <label for="maxPriceRange" class="form-label">Giá tối đa</label>
                                <input type="range" class="form-range" id="maxPriceRange" min="0" max="5000000" value="5000000" step="10000">

                                <div class="d-flex justify-content-between">
                                    <span>Giá tối thiểu: <strong><span id="minPriceDisplay">0</span> ₫</strong></span>
                                    <span>Giá tối đa: <strong><span id="maxPriceDisplay">5.000.000</span> ₫</strong></span>
                                </div>

                                <input type="hidden" name="minPrice" id="minPriceInput" value="0">
                                <input type="hidden" name="maxPrice" id="maxPriceInput" value="5000000">
                            </div>
                        </div>


                        <!-- Nút lọc -->
                        <div class="col-lg-12 text-center">
                            <button type="submit" class="btn btn-primary w-100">Lọc sản phẩm</button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Cột Sản phẩm -->
            <div class="col-lg-9">
                @if (Model.FilteredProducts != null && Model.FilteredProducts.Any())
                {
                    <div class="row g-4 justify-content-center">
                        @foreach (var product in Model.FilteredProducts)
                        {
                            <div class="col-md-6 col-lg-4">
                                <a href="@Url.Action("Index", "ProductDetail", new { id = product.ProductId })" class="text-decoration-none text-dark">
                                    <div class="card mb-3 shadow-sm">
                                        <div class="product-img">
                                            <img src="@(product.SubProducts.FirstOrDefault()?.Linkimage ?? "placeholder.jpg")"
                                                 class="img-fluid w-100 rounded-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                                        </div>
                                        <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                                            <h5 class="text-center mb-3">@product.ProductName</h5>
                                            <div class="text-center text-danger fw-bold mb-2">
                                                @((product.SubProducts.FirstOrDefault()?.DiscountedPrice ?? 0).ToString("N0")) ₫
                                            </div>
                                            <div class="text-center">
                                                <a href="@Url.Action("Index", "ProductDetail", new { id = product.ProductId })"
                                                   class="btn btn-outline-primary rounded-pill px-3">
                                                    <i class="fa fa-shopping-bag me-2"></i> Thêm vào giỏ hàng
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center">Không có sản phẩm nào phù hợp với tiêu chí đã chọn.</p>
                }

                <!-- Phân trang -->
                <div class="col-12">
                    <div class="pagination d-flex justify-content-center mt-5" id="pagination"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JS xử lý hiển thị giá -->
<script>
    const minPriceRange = document.getElementById('minPriceRange');
    const maxPriceRange = document.getElementById('maxPriceRange');
    const minPriceDisplay = document.getElementById('minPriceDisplay');
    const maxPriceDisplay = document.getElementById('maxPriceDisplay');
    const minPriceInput = document.getElementById('minPriceInput');
    const maxPriceInput = document.getElementById('maxPriceInput');

    function updatePriceLabels() {
        minPriceDisplay.textContent = parseInt(minPriceRange.value).toLocaleString();
        maxPriceDisplay.textContent = parseInt(maxPriceRange.value).toLocaleString();
        minPriceInput.value = minPriceRange.value;
        maxPriceInput.value = maxPriceRange.value;
    }

    minPriceRange.addEventListener('input', updatePriceLabels);
    maxPriceRange.addEventListener('input', updatePriceLabels);
    updatePriceLabels();
</script>

<!-- JS xử lý phân trang -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const totalPages = @Model.TotalPages;
        const currentPage = @Model.PageNumber;

        function createPagination() {
            const paginationElement = document.getElementById('pagination');
            paginationElement.innerHTML = '';

            if (currentPage > 1) {
                const prev = createPageButton("Trang trước", currentPage - 1);
                paginationElement.appendChild(prev);
            }

            for (let i = 1; i <= totalPages; i++) {
                const btn = createPageButton(i, i);
                if (i === currentPage) btn.classList.add('btn-primary');
                paginationElement.appendChild(btn);
            }

            if (currentPage < totalPages) {
                const next = createPageButton("Trang sau", currentPage + 1);
                paginationElement.appendChild(next);
            }
        }

        function createPageButton(text, pageNumber) {
            const a = document.createElement('a');
            a.href = '#';
            a.className = 'btn btn-outline-secondary mx-1';
            a.textContent = text;
            a.onclick = function (e) {
                e.preventDefault();
                changePage(pageNumber);
            };
            return a;
        }

        function changePage(pageNumber) {
            const form = document.createElement('form');
            form.method = 'get';
            form.action = '@Url.Action("FilterColor_Size", "Search")';

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'PageNumber';
            input.value = pageNumber;
            form.appendChild(input);

            document.body.appendChild(form);
            form.submit();
        }

        createPagination();
    });
</script>
