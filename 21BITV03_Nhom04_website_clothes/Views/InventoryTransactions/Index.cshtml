@model IEnumerable<_21BITV03_Nhom04_website_clothes.Data.InventoryTransaction>

@{
    ViewData["Title"] = "Danh sách giao dịch kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh sách giao dịch kho</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item active">Giao dịch kho</li>
    </ol>

    <p class="d-flex justify-content-between">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm giao dịch mới
        </a>

        <form asp-action="ImportExcel" asp-controller="InventoryTransactions" enctype="multipart/form-data" method="post" class="d-flex align-items-center gap-2">
            <input type="file" name="excelFile" class="form-control form-control-sm" accept=".xlsx,.xls" required />
            <button type="submit" class="btn btn-success btn-sm">
                <i class="fas fa-file-import me-1"></i> Nhập từ Excel
            </button>
        </form>
    </p>


    <div class="card mb-4 shadow-sm rounded-3">
        <div class="card-header">
            <i class="fas fa-exchange-alt me-2"></i> Danh sách giao dịch kho
        </div>
        <div class="card-body">
            <table id="datatablesSimple" class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Loại giao dịch</th>
                        <th>Ngày giao dịch</th>
                        <th>Ghi chú</th>
                        <th>Nhà cung cấp</th>
                        <th>Kho</th>
                        <th class="text-center">Thông tin giao dịch chi tiết</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tfoot class="table-light">
                    <tr>
                        <th>Loại giao dịch</th>
                        <th>Ngày giao dịch</th>
                        <th>Ghi chú</th>
                        <th>Nhà cung cấp</th>
                        <th>Kho</th>
                        <th class="text-center">Thông tin chi tiết</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.TransactionType)</td>
                            <td>@Html.DisplayFor(modelItem => item.TransactionDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                            <td>@Html.DisplayFor(modelItem => item.Supplier.SupplierName)</td>
                            <td>@Html.DisplayFor(modelItem => item.Warehouse.WarehouseName)</td>
                            <td class="text-center">
                                <a asp-action="Index" asp-controller="InventoryTransactionDetails" asp-route-transactionId="@item.TransactionId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </td>

                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.TransactionId" class="btn btn-sm btn-warning me-1" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TransactionId" class="btn btn-sm btn-danger" title="Xoá">
                                    <i class="fas fa-trash"></i> Xoá
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
