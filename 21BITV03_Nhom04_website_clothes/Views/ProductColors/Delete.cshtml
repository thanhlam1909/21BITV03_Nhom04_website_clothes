@model _21BITV03_Nhom04_website_clothes.Data.ProductColor

@{
    ViewData["Title"] = "Xóa Màu Sản Phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Xóa Màu Sản Phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="ProductColors" asp-action="Index"><i class="fas fa-palette me-1"></i> Danh sách màu sản phẩm</a>
        </li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-trash-alt me-2"></i> Xác nhận xóa màu sản phẩm
        </div>
        <div class="card-body p-4">
            <h4 class="text-danger mb-4"><i class="fas fa-exclamation-triangle me-2"></i>Bạn có chắc chắn muốn xóa màu này không?</h4>

            <dl class="row">
                <dt class="col-sm-3 fw-bold">
                    Tên màu:
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ColorName)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    Mô tả:
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Description)
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="ColorId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i> Xóa
                    </button>
                    <a asp-action="Index" asp-route-transactionId="@ViewBag.TransactionId" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
