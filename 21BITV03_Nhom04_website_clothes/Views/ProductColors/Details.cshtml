@model _21BITV03_Nhom04_website_clothes.Data.ProductColor

@{
    ViewData["Title"] = "Chi tiết màu sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết màu sản phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="ProductColors" asp-action="Index"><i class="fas fa-palette me-1"></i> Danh sách màu sản phẩm</a>
        </li>
        <li class="breadcrumb-item active">Chi tiết</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header">
            <i class="fas fa-info-circle me-2"></i> Thông tin màu sản phẩm
        </div>
        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-3 fw-bold">
                    Tên màu:
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ColorName)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    Mô tả:
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Description)
                </dd>
            </dl>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.ColorId" class="btn btn-primary">
                    <i class="fas fa-edit me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
