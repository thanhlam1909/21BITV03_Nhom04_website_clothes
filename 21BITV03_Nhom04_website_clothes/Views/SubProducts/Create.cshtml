@model _21BITV03_Nhom04_website_clothes.Data.SubProduct

@{
    ViewData["Title"] = "Tạo sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Tạo sản phẩm biến thể</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-productId="@ViewBag.MainProductId"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item active">Tạo sản phẩm</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header">
            <i class="fas fa-plus-circle me-2"></i> Thêm sản phẩm biến thể mới
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Hidden MainProductId -->
                <input type="hidden" asp-for="MainProductId" value="@ViewBag.MainProductId" />

                <div class="form-group">
                    <label asp-for="OriginalPrice" class="control-label"></label>
                    <input asp-for="OriginalPrice" class="form-control" placeholder="Nhập giá gốc" />
                    <span asp-validation-for="OriginalPrice" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DiscountedPrice" class="control-label"></label>
                    <input asp-for="DiscountedPrice" class="form-control" placeholder="Nhập giá giảm" />
                    <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ColorId" class="control-label"></label>
                    <select asp-for="ColorId" class="form-control" asp-items="ViewBag.ColorId">
                        <option value="">Chọn màu sắc</option>
                    </select>
                    <span asp-validation-for="ColorId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SizeId" class="control-label"></label>
                    <select asp-for="SizeId" class="form-control" asp-items="ViewBag.SizeId">
                        <option value="">Chọn kích thước</option>
                    </select>
                    <span asp-validation-for="SizeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Linkimage" class="control-label"></label>
                    <input type="file" name="imageFile" class="form-control" />
                    <span asp-validation-for="Linkimage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="control-label"></label>
                    <input asp-for="Status" class="form-control" placeholder="Trạng thái sản phẩm" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaterialId" class="control-label"></label>
                    <select asp-for="MaterialId" class="form-control" asp-items="ViewBag.MaterialId">
                        <option value="">Chọn chất liệu</option>
                    </select>
                    <span asp-validation-for="MaterialId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="skuCode" class="control-label">Mã SKU</label>
                    <input type="text" name="skuCode" class="form-control" placeholder="Nhập mã SKU" />
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Tạo mới" class="btn btn-primary" />
                    <a asp-action="Index" asp-route-productId="@ViewBag.MainProductId" class="btn btn-secondary ml-2">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>
