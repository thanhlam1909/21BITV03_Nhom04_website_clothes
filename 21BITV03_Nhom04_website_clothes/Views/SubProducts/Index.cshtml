@model IEnumerable<_21BITV03_Nhom04_website_clothes.Data.SubProduct>

@{
    ViewData["Title"] = "Biến thể sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh sách biến thể sản phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item"><a asp-controller="ProductS" asp-action="Index">Danh sách sản phẩm</a></li>

        <li class="breadcrumb-item active">Biến thể sản phẩm</li>
    </ol>

    @* <h5>Sản phẩm chính: Mã @ViewBag.MainProductId</h5> *@

    <p>
        <a asp-action="Create" asp-route-productId="@ViewBag.MainProductId" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm biến thể sản phẩm
        </a>
    </p>

    <div class="card mb-4 shadow-sm rounded-3">
        <div class="card-header">
            <i class="fas fa-box-open me-2"></i> Danh sách biến thể sản phẩm
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Giá gốc</th>
                        <th>Giá khuyến mãi</th>
                        <th>Ngày tạo</th>
                        <th>Hình ảnh</th>
                        <th>Trạng thái</th>
                        <th>Màu sắc</th>
                        <th>Sản phẩm chính</th>
                        <th>Chất liệu</th>
                        <th>Kích cỡ</th>
                        <th>Mã SKU</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OriginalPrice ₫</td>
                            <td>@item.DiscountedPrice ₫</td>
                            <td>@item.CreationDate</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Linkimage))
                                {
                                    <img src="@item.Linkimage" alt="Hình ảnh" width="80" class="rounded shadow-sm" />
                                }
                                else
                                {
                                    <span>Không có ảnh</span>
                                }
                            </td>
                            <td>@item.Status</td>
                            <td>@item.Color?.ColorName</td>
                            <td>@item.MainProduct?.ProductName</td>
                            <td>@item.Material?.MaterialName</td>
                            <td>@item.Size?.SizeName</td>
                            <td>@item.Sku?.SkuCode</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.SubProductId" asp-route-productId="@ViewBag.MainProductId" class="btn btn-sm btn-warning me-1">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.SubProductId" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Xoá
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
