@model _21BITV03_Nhom04_website_clothes.Data.SubProduct

@{
    ViewData["Title"] = "Chỉnh sửa biến thể sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chỉnh sửa biến thể sản phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang quản trị</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-route-productId="@Model.MainProductId" asp-action="Index"><i class="fas fa-cogs me-1"></i> Danh sách biến thể sản phẩm</a>
        </li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-2"></i> Cập nhật thông tin biến thể sản phẩm
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="SubProductId" />
                <input type="hidden" asp-for="MainProductId" />

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Sản phẩm chính</label>
                    <input class="form-control" value="@Model.MainProductId" disabled />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OriginalPrice" class="form-label fw-bold">Giá gốc</label>
                    <input asp-for="OriginalPrice" class="form-control" />
                    <span asp-validation-for="OriginalPrice" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DiscountedPrice" class="form-label fw-bold">Giá giảm</label>
                    <input asp-for="DiscountedPrice" class="form-control" />
                    <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ColorId" class="form-label fw-bold">Màu sắc</label>
                    <select asp-for="ColorId" class="form-control" asp-items="ViewBag.ColorId"></select>
                    <span asp-validation-for="ColorId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CreationDate" class="form-label fw-bold">Ngày tạo</label>
                    <input asp-for="CreationDate" class="form-control" type="datetime-local" readonly />
                    <span asp-validation-for="CreationDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SizeId" class="form-label fw-bold">Kích thước</label>
                    <select asp-for="SizeId" class="form-control" asp-items="ViewBag.SizeId"></select>
                    <span asp-validation-for="SizeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Hình ảnh</label>
                    <input type="file" name="imageFile" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.Linkimage))
                    {
                        <img src="@Model.Linkimage" alt="Hình ảnh hiện tại" class="mt-2" style="max-width: 200px;" />
                    }
                    <input type="hidden" name="imageFile" value="@Model.Linkimage" />
                    <span asp-validation-for="Linkimage" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                    <input asp-for="Status" class="form-control" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MaterialId" class="form-label fw-bold">Chất liệu</label>
                    <select asp-for="MaterialId" class="form-control" asp-items="ViewBag.MaterialId"></select>
                    <span asp-validation-for="MaterialId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">SKU Code</label>
                    <input type="text" name="skuCode" class="form-control" value="@ViewBag.SkuCode" />
                </div>

                <div class="form-group d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" asp-route-productId="@ViewBag.MainProductId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
