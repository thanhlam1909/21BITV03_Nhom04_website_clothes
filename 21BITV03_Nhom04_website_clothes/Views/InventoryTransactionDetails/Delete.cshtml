@model _21BITV03_Nhom04_website_clothes.Data.InventoryTransactionDetail

@{
    ViewData["Title"] = "Xóa chi tiết giao dịch kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Xóa chi tiết giao dịch kho</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-transactionId="@Model.TransactionId">Chi tiết giao dịch kho</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-header text-danger fw-bold">
            <i class="fas fa-trash-alt me-2"></i> Xác nhận xóa chi tiết giao dịch
        </div>
        <div class="card-body">
            <div class="alert alert-warning mb-4">
                <strong>Bạn có chắc chắn muốn xóa chi tiết này không?</strong> Thao tác này không thể hoàn tác.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Sản phẩm phụ</dt>
                <dd class="col-sm-9">@Model.SubProductId</dd>

                <dt class="col-sm-3">Số lượng</dt>
                <dd class="col-sm-9">@Model.Quantity</dd>

                <dt class="col-sm-3">Đơn giá</dt>
                <dd class="col-sm-9">@String.Format("{0:N0} VNĐ", Model.UnitPrice)</dd>

                <dt class="col-sm-3">Mã giao dịch</dt>
                <dd class="col-sm-9">@Model.Transaction?.TransactionId</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="TransactionDetailId" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i> Xóa
                </button>
                <a asp-action="Index" asp-route-transactionId="@Model.TransactionId" class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </form>
        </div>
    </div>
</div>
