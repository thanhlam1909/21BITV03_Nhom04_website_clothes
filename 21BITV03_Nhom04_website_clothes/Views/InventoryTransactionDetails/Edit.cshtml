@model _21BITV03_Nhom04_website_clothes.Data.InventoryTransactionDetail

@{
    ViewData["Title"] = "Chỉnh sửa chi tiết giao dịch kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chỉnh sửa chi tiết giao dịch kho</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang quản trị</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-transactionId="@Model.TransactionId">Chi tiết giao dịch kho</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="TransactionDetailId" />

                <div class="mb-3">
                    <label asp-for="TransactionId" class="form-label fw-bold"></label>
                    <select asp-for="TransactionId" class="form-select" asp-items="ViewBag.TransactionId"></select>
                    <span asp-validation-for="TransactionId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SubProductId" class="form-label fw-bold"></label>
                    <select asp-for="SubProductId" class="form-select" asp-items="ViewBag.SubProductId"></select>
                    <span asp-validation-for="SubProductId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label fw-bold"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UnitPrice" class="form-label fw-bold"></label>
                    <input asp-for="UnitPrice" class="form-control" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" asp-route-transactionId="@Model.TransactionId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
